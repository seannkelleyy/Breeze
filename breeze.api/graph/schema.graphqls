  institutionName: String
  itemId: String!
  createdAt: String!
  updatedAt: String!
}

type PlaidAccount {
  id: ID!
  plaidConnectionId: ID!
  externalId: String!
  name: String!
  officialName: String
  type: String
  subtype: String
  currentBalance: String
  isoCurrencyCode: String
  createdAt: String!
  updatedAt: String!
}

