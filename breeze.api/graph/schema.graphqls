type TaxBracket {
  id: ID!
  year: Int!
  filingStatus: FilingStatus!
  minimumAmount: String!
  maximumAmount: String
  rate: String!
  createdAt: String!
  updatedAt: String!
}

type TaxYearData {
  year: Int!
  brackets: [TaxBracket!]!
  standardDeduction: String!
  ssWageBase: String!
}

type TaxEstimate {
  taxOwed: String!
  taxableIncome: String!
  effectiveRate: String!
  marginalRate: String!
}

input CreateTaxBracketInput {
  year: Int!
  filingStatus: FilingStatus!
  minimumAmount: String!
  maximumAmount: String
  rate: String!
}

input UpdateTaxBracketInput {
  id: ID!
  year: Int!
  filingStatus: FilingStatus!
  minimumAmount: String!
  maximumAmount: String
  rate: String!
}

