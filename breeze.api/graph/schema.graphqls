type NetWorthSnapshot {
  id: ID!
  userId: ID!
  snapshotDate: String!
  totalAssets: String!
  totalLiabilities: String!
  netWorth: String!
  createdAt: String!
  updatedAt: String!
}

input CreateNetWorthSnapshotInput {
  userId: ID!
  snapshotDate: String!
  totalAssets: String!
  totalLiabilities: String!
  netWorth: String!
}

input UpdateNetWorthSnapshotInput {
  id: ID!
  totalAssets: String
  totalLiabilities: String
